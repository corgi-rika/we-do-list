// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model profiles {
  id        String   @id @default(uuid()) @db.Uuid
  user_id   String   @unique @db.Uuid
  username  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  ownedGroups      groups[]
  groupMemberships group_members[]

  @@map("profiles")
}

model groups {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(15)
  team_code String   @unique @db.VarChar(10)
  owner_id  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  owner profiles @relation(fields: [owner_id], references: [user_id], onDelete: Cascade)
  members group_members[]
  categories categories[]

  @@map("groups")
}

model group_members {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id  String   @db.Uuid
  user_id   String   @db.Uuid
  role      String   @default("member") @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  group groups   @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  profiles @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@map("group_members")
}

model categories {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id  String   @db.Uuid
  name      String   @db.VarChar(15)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  group groups @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@map("categories")
}